# Response header rules, in the format many static hosts read.
#
# Applying these is the deployer's job. A host that does not read this
# file needs the same headers configured its own way.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  # No third-party origin appears anywhere in this policy. Typefaces are
  # self-hosted, there is no analytics script, and connect-src is 'self', so the
  # page cannot transmit anything anywhere even if a future change tried to.
  # connect-src also names, exactly, the newsletter endpoint on this origin:
  # the suite footer (bench-chrome 1.3.0) posts there only an email address the
  # reader chooses to submit.
  # scripts/check-privacy.mjs fails the build if any external origin is added.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com/beacon.min.js https://static.cloudflareinsights.com/beacon.min.js/ https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://benchtools.ligant.ai/api/subscribe https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://www.google.com https://*.g.doubleclick.net; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Extensionless, so a static host would offer it as a download rather than
# showing it. A licence is meant to be read in the tab the reader is already in.
/LICENSE
  Content-Type: text/plain; charset=utf-8

# Asset filenames carry a content hash, so they can be cached indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry document must revalidate, or a deploy never reaches returning users.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

